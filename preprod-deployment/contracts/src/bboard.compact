// ============================================================================
// Midnight Network Smart Contract: VoxMidnight - Confidential DAO Governance
// Language: Compact (Midnight Smart Contract DSL)
// Level: 3 Production Specification for Hackathon Submission
// ============================================================================

pragma language_version >= 0.15;

import CompactStandardLibrary;

export ledger proposalId: Uint<32>;
export ledger yesCount: Counter;
export ledger noCount: Counter;
export ledger totalVotes: Counter;
export ledger votingActive: Boolean;
export ledger admin: Bytes<32>;
export ledger nullifiers: Set<Bytes<32>>;

// ----------------------------------------------------------------------------
// Private Witnesses (Executed strictly inside user's client-side ZK prover)
// ----------------------------------------------------------------------------
witness voterChoiceWitness(): Boolean;
witness voterSecretWitness(): Bytes<32>;
witness voterEligibilityWitness(): Uint<16>;

// ----------------------------------------------------------------------------
// Constructor
// ----------------------------------------------------------------------------
constructor(initialProposalId: Uint<32>, adminPublicKey: Bytes<32>) {
    proposalId = disclose(initialProposalId);
    votingActive = true;
    admin = disclose(adminPublicKey);
}

// ----------------------------------------------------------------------------
// Circuits (Zero-Knowledge Verifiable State Transitions)
// ----------------------------------------------------------------------------

export circuit castBallot(nullifierHash: Bytes<32>): [] {
    const disclosedNullifier: Bytes<32> = disclose(nullifierHash);

    assert(votingActive, "Governance voting is currently closed or resolved");
    assert(!nullifiers.member(disclosedNullifier), "Nullifier already spent: Double-voting is strictly forbidden");

    const choice = voterChoiceWitness();
    const secret = voterSecretWitness();
    const eligibilityScore = voterEligibilityWitness();

    assert(eligibilityScore > 0, "Voter has insufficient governance weight or is ineligible");

    const isYes: Boolean = disclose(choice);

    if (isYes) {
        yesCount.increment(1);
    } else {
        noCount.increment(1);
    }
    totalVotes.increment(1);

    nullifiers.insert(disclosedNullifier);
}

export circuit setVotingActive(active: Boolean): [] {
    votingActive = disclose(active);
}

export circuit setProposalId(newProposalId: Uint<32>): [] {
    const disclosedProposalId = disclose(newProposalId);
    assert(disclosedProposalId > proposalId, "New proposal ID must be strictly greater than previous");
    proposalId = disclosedProposalId;
    votingActive = true;
}
